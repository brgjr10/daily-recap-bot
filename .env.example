# ==== standup daily recap ====
# Copy to .env and fill in. Real environment variables always
# override values set here. Everything is optional except a
# webhook (without one, the script refuses to send).

# Discord webhook URL(s) that receive the recap.
# Get one: Discord server -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# Multiple destinations: comma-separate them.
STANDUP_WEBHOOK=

# Optional GitHub personal access token (public_repo scope minimum;
# repo scope for private repos). Leave empty to reuse the brain-mcp
# token from F:\MCP Database\brain-mcp\config.json, which already
# has access to brgjr10/second_brain and your private repos.
GITHUB_TOKEN=

# Optional LLM prose summary. Point STANDUP_LLM_API_URL at any
# OpenAI-compatible /chat/completions endpoint (e.g. your local
# ModelRouter) and the recap opens with a generated paragraph
# instead of the rule-based one. Leave all three empty to disable.
STANDUP_LLM_API_URL=
STANDUP_LLM_API_KEY=
STANDUP_LLM_MODEL=
